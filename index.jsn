/* =========================
   HOME
========================= */

function showHome() {
  main.setContent(
    `{bold}{cyan-fg}Developer :{/cyan-fg} IyanzNotDev{/bold}\n` +
      `{bold}{cyan-fg}Version   :{/cyan-fg} 2.1.1{/bold}\n\n` +
      `{cyan-fg}W E L C O M E{/cyan-fg}\n\n` +
      `{bold}Welkom{/bold}\n\n` +
      `{gray-fg}Multi-purpose CLI Toolkit{/gray-fg}`
  );

  menu.focus();
  screen.render();
}

function showLoading(feature) {
  main.setContent(
    `{bold}{cyan-fg}${feature}{/cyan-fg}{/bold}\n\n` +
      `{yellow-fg}Loading...{/yellow-fg}\n\n` +
      `{gray-fg}Please wait{/gray-fg}`
  );

  screen.render();
}

function createInput(
  label,
  width = "60%",
  height = 7
) {
  const box = blessed.textbox({
    top: "center",
    left: "center",
    width,
    height,
    border: {
      type: "line",
    },
    label,
    inputOnFocus: true,
    keys: true,
    mouse: true,
    style: {
      border: {
        fg: "cyan",
      },
      focus: {
        border: {
          fg: "cyan",
        },
      },
    },
    padding: {
      left: 1,
      right: 1,
    },
  });

  screen.append(box);
  box.focus();
  screen.render();

  return box;
}

function showResult(title, content) {
  main.setContent(
    `{bold}{cyan-fg}${title}{/cyan-fg}{/bold}\n\n` +
      `${content}\n\n` +
      `{gray-fg}Press Esc to return{/gray-fg}`
  );

  menu.focus();
  screen.render();
}

/* =========================
   CHECK PROVIDER
========================= */

function checkProviderUI() {
  const box = createInput(
    " Check Provider ",
    "65%",
    8
  );

  box.on("submit", async (value) => {
    box.destroy();

    const input = value.trim();

    if (!input) {
      showResult(
        "Check Provider",
        "{red-fg}Nomor tidak boleh kosong.{/red-fg}"
      );
      return;
    }

    showLoading("Check Provider");

    try {
      const result = checkProvider(input);

      if (!result.valid) {
        showResult(
          "Check Provider",
          `{red-fg}${result.message}{/red-fg}`
        );
        return;
      }

      showResult(
        "Check Provider",
        `Nomor    : ${result.number}\n` +
          `Prefix   : ${result.prefix}\n` +
          `Provider : {cyan-fg}${result.provider}{/cyan-fg}\n\n` +
          `{gray-fg}${result.message}{/gray-fg}`
      );
    } catch (error) {
      showResult(
        "Check Provider",
        `{red-fg}Error:{/red-fg} ${error.message}`
      );
    }
  });

  box.key("escape", () => {
    box.destroy();
    showHome();
  });
}

